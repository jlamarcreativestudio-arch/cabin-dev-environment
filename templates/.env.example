# Copy to .env only when the current task explicitly needs a credential.
# .env is ignored by Git. Never place real values in this example.

# Source custody
GITHUB_TOKEN=

# Model providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional provider or router endpoints. Keep endpoint choice task-scoped.
OPENCLAW_ENDPOINT=
ROUTER_ENDPOINT=

# Optional MCP configuration supplied by the host, not by this repository.
MCP_CONFIG_PATH=

# Optional task checkout location. Defaults are illustrative only.
TASK_WORKSPACE=/workspace
